# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/inventory_db
# For local host development:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/inventory_db

# JWT & Authentication
JWT_SECRET_KEY=super-secret-inventory-jwt-encryption-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Configuration
APP_NAME=Inventory Management System
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
LOG_LEVEL=INFO
